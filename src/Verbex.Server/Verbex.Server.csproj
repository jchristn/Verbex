<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<StartupObject>Verbex.Server.VerbexServer</StartupObject>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>1701;1702;CS8600;CS8601;CS8602;CS8629</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Watson" Version="7.1.0" />
		<PackageReference Include="SyslogLogging" Version="2.2.1" />
		<PackageReference Include="Timestamps" Version="1.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Verbex\Verbex.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="clean.bat">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="clean.sh">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
